            "html": "<style>\n/* Scoped presentation helpers. Text, media, spacing, type and colour controls remain native. */\n:where(.ss-design) { --ss-ink:#181a16; --ss-olive:#7e8e76; --ss-cream:#f8f5eb; --ss-tan:#d6c3ae; color:var(--ss-ink); font-family:Arial,Helvetica,sans-serif; }\n:where(.ss-design) * { box-sizing:border-box; }\n:where(.ss-design) a { text-decoration:none; }\n:where(.ss-design) p:last-child { margin-bottom:0; }\n:where(.ss-design) .elementor-heading-title { text-transform:none; }\n:where(.ss-design) em { font-weight:400; }\n:where(.ss-design) :focus-visible { outline:2px solid currentColor; outline-offset:5px; }\n.ss-design.ss-wrap { max-width:min(1320px,calc(100% - 10vw)); margin-inline:auto; }\n.ss-design.ss-zero { min-height:0; height:0; overflow:visible; padding:0; margin:0; }\n.ss-design .ss-link .elementor-button { padding:10px 0; border-bottom:1px solid currentColor; }\n.ss-design .ss-button .elementor-button { min-height:50px; display:inline-flex; align-items:center; justify-content:space-between; gap:28px; }\n.ss-design .ss-has-arrow .elementor-button-content-wrapper { width:100%; }\n.ss-design .ss-has-arrow .elementor-button-text { display:flex; align-items:center; justify-content:space-between; gap:28px; text-align:left; }\n.ss-design .ss-has-arrow .elementor-button-text::after { content:'↗'; font-size:21px; line-height:1; }\n.ss-design .ss-card-image img { display:block; width:100%; height:330px; object-fit:cover; transition:transform .35s ease; }\n.ss-design .ss-card-image { overflow:hidden; }\n.ss-design .ss-card-image:hover img { transform:scale(1.025); }\n.ss-design .ss-hero { isolation:isolate; }\n.ss-design .ss-logo img { width:92px; height:80px; object-fit:contain; }\n.ss-design .ss-story-image img { width:100%; height:auto; aspect-ratio:1; object-fit:cover; border:8px solid #f8f5eb; }\n.ss-design .ss-soak-image img { width:100%; height:auto; aspect-ratio:1.93; object-fit:cover; }\n.ss-design .ss-soak-card { z-index:2; }\n.ss-design .ss-guide-image img { width:100%; height:auto; aspect-ratio:1.7; object-fit:cover; }\n.ss-design .ss-eyebrow .elementor-heading-title { line-height:1.7; }\n.ss-design .ss-style-widget { width:100%; margin:0; }\n\n/* Booking search bar */\n.ss-search { display:grid; grid-template-columns:1fr 1fr .85fr 1.15fr; background:#ffffff; padding:16px; border:1px solid #e5e4da; box-shadow:0 12px 40px #0000000b; font-family:Arial,Helvetica,sans-serif; align-items:center; }\n.ss-search-date, .ss-search-guests { display:grid; text-align:left; gap:6px; padding:6px 24px; position:relative; min-width:0; border-right:1px solid #d8d8cc; min-height:58px; align-content:center; background:transparent; border-top:0; border-bottom:0; border-left:0; cursor:pointer; }\n.ss-search-date:hover { background:#f8f5eb; }\n.ss-eyebrow { font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#595d54; }\n.ss-date-val { font-size:17px; color:#181a16; font-weight:500; white-space:nowrap; }\n.ss-field-arrow { position:absolute; right:20px; bottom:12px; font-size:18px; color:#595d54; pointer-events:none; }\n.ss-search-guests { border-right:0; cursor:default; }\n.ss-search-guests select { font:17px Arial,Helvetica,sans-serif; width:100%; color:#181a16; background:transparent; border:0; border-radius:0; padding:2px 0; min-height:28px; cursor:pointer; font-weight:500; }\n.ss-search-submit { background:#181a16; color:#ffffff; border:0; border-radius:4px; font:700 13px Arial,Helvetica,sans-serif; min-height:64px; padding:15px 24px; display:inline-flex; align-items:center; justify-content:space-between; gap:16px; cursor:pointer; transition:background .2s; }\n.ss-search-submit:hover { background:#7e8e76; color:#000000; }\n.ss-search-submit span { font-size:20px; }\n.ss-search-error { font:14px/1.6 Arial,Helvetica,sans-serif; color:#82382a; margin-top:12px; }\n.ss-search-note { font:11px/1.5 Arial,Helvetica,sans-serif; color:#595d54; margin:14px 0 0; }\n.ss-search-note a { text-decoration:underline; color:inherit; }\n\n/* Custom Date Picker Modal */\n.ss-date-dialog { border:0; padding:0; color:#181a16; width:min(780px,calc(100% - 48px)); max-height:calc(100dvh - 48px); background:#ffffff; box-shadow:0 24px 80px rgba(0,0,0,.25); font-family:Arial,Helvetica,sans-serif; z-index:99999; }\n.ss-date-dialog::backdrop { background:rgba(23,26,22,.65); backdrop-filter:blur(3px); }\n.ss-dialog-header { padding:28px 32px 20px; display:flex; justify-content:space-between; align-items:center; gap:20px; }\n.ss-dialog-header h2 { font:32px Georgia,serif; margin:0; }\n.ss-dialog-header .ss-eyebrow { margin-bottom:6px; }\n.ss-close-btn { width:44px; height:44px; display:flex; align-items:center; justify-content:center; font-size:27px; border:1px solid #d8d8cc; background:transparent; cursor:pointer; border-radius:50%; }\n.ss-close-btn:hover { background:#f8f5eb; }\n.ss-date-summary { margin-inline:32px; padding:14px 0; display:grid; grid-template-columns:1fr 1fr; gap:20px; border-bottom:1px solid #d8d8cc; }\n.ss-date-summary button { text-align:left; padding:10px 14px; border:1px solid transparent; border-bottom:2px solid transparent; background:transparent; cursor:pointer; }\n.ss-date-summary button.active { background:#f8f5eb; border-color:#d6c3ae; border-bottom-color:#181a16; }\n.ss-date-summary [data-ss-draft-label] { display:block; margin-top:4px; font-size:16px; font-weight:600; color:#181a16; }\n.ss-cal-nav { display:flex; align-items:center; justify-content:space-between; margin:18px 32px 0; }\n.ss-cal-nav button { width:44px; height:44px; font-size:22px; border:1px solid #d8d8cc; background:transparent; cursor:pointer; border-radius:4px; }\n.ss-cal-nav button:hover:not(:disabled) { background:#f8f5eb; }\n.ss-cal-nav button:disabled { opacity:.3; cursor:not-allowed; }\n.ss-cal-nav p { font-size:12px; color:#595d54; margin:0; font-weight:600; text-transform:uppercase; letter-spacing:.08em; }\n.ss-cal-months { display:grid; grid-template-columns:1fr 1fr; gap:32px; padding:12px 32px 26px; }\n.ss-cal-month h3 { font:18px Georgia,serif; text-align:center; margin:0 0 16px; }\n.ss-weekdays, .ss-day-grid { display:grid; grid-template-columns:repeat(7,1fr); }\n.ss-weekdays span { text-align:center; font-size:10px; color:#595d54; padding-block:8px; font-weight:600; }\n.ss-cal-day { width:100%; min-height:44px; font-size:13px; padding:6px 0; position:relative; border:0; background:transparent; cursor:pointer; font-family:inherit; }\n.ss-cal-day:disabled { color:#a1a397; text-decoration:line-through; cursor:not-allowed; }\n.ss-cal-day:not(:disabled):hover { background:#f8f5eb; box-shadow:inset 0 0 0 1px #7e8e76; }\n.ss-cal-day.in-range { background:#f8f5eb; }\n.ss-cal-day.selected { background:#181a16; color:#ffffff; }\n.ss-cal-day.today::after { content:''; position:absolute; bottom:6px; left:calc(50% - 2px); border-radius:50%; width:4px; height:4px; background:currentColor; }\n.ss-cal-footer { border-top:1px solid #d8d8cc; padding:20px 32px; display:flex; align-items:center; justify-content:space-between; gap:20px; background:#f8f5eb; }\n.ss-cal-footer p { font-size:13px; max-width:320px; margin:0; color:#595d54; }\n.ss-apply-btn { background:#181a16; color:#ffffff; border:0; border-radius:4px; padding:12px 24px; font:700 12px Arial,Helvetica,sans-serif; cursor:pointer; display:inline-flex; align-items:center; gap:12px; }\n.ss-apply-btn:hover:not(:disabled) { background:#7e8e76; color:#000000; }\n.ss-apply-btn:disabled { opacity:.4; cursor:not-allowed; }\n\n/* Mobile Menu */\n.ss-mobile-menu { position:relative; font:13px Arial,Helvetica,sans-serif; }\n.ss-mobile-menu summary { min-height:44px; display:flex; align-items:center; cursor:pointer; list-style:none; }\n.ss-mobile-menu summary::-webkit-details-marker { display:none; }\n.ss-mobile-menu nav { position:absolute; right:0; top:52px; z-index:90; min-width:240px; padding:18px 24px; background:#f8f5eb; box-shadow:0 8px 25px #0002; }\n.ss-mobile-menu nav a { display:block; font:23px/1.3 Georgia,serif; color:#181a16; padding:14px 0; border-bottom:1px solid #d6c3ae; }\n\n@media(max-width:1024px) {\n  .ss-design.ss-wrap { max-width:calc(100% - 64px); }\n  .ss-design .ss-card-image img { height:270px; }\n  .ss-search-date, .ss-search-guests { padding-inline:16px; }\n}\n@media(max-width:767px) {\n  .ss-design.ss-wrap { max-width:calc(100% - 48px); }\n  .ss-design .ss-logo img { width:74px; height:68px; }\n  .ss-design .ss-card-image img { height:auto; aspect-ratio:1.16; }\n  .ss-design .ss-soak-image img { aspect-ratio:1.25; }\n  .ss-design .ss-story-image { max-width:390px; }\n  .ss-search { grid-template-columns:1fr; padding:12px; gap:8px; }\n  .ss-search-date, .ss-search-guests { border-right:0; border-bottom:1px solid #d8d8cc; padding:14px 18px; min-height:64px; }\n  .ss-search-submit { width:100%; justify-content:center; }\n  .ss-date-dialog { width:100%; max-width:none; height:100dvh; max-height:100dvh; margin:0; }\n  .ss-dialog-header { padding:20px 24px 14px; }\n  .ss-dialog-header h2 { font-size:26px; }\n  .ss-date-summary { margin-inline:20px; }\n  .ss-cal-nav { margin-inline:20px; }\n  .ss-cal-months { grid-template-columns:1fr; padding-inline:20px; }\n  .ss-cal-month:nth-child(2) { display:none; }\n  .ss-cal-footer { padding:18px 20px; position:sticky; bottom:0; }\n}\n@media(prefers-reduced-motion:reduce) { .ss-design * { transition:none!important; animation:none!important; scroll-behavior:auto!important; } }\n/* Reviewed homepage 0.2.5 */\n.ss-design .ss-view-suite .elementor-button { width:100%; text-align:left; padding:12px 18px; }\n.ss-design .ss-view-suite .elementor-button-text { text-align:left; }\n.ss-design .ss-story-image img { border:0; aspect-ratio:1.12; }\n.ss-design .ss-intro-detail img { width:100%; aspect-ratio:1.25; object-fit:cover; }\n.ss-design .ss-card .elementor-widget-button { width:100%; }\n.ss-faq-source summary { cursor:pointer; padding-block:18px; font:23px/1.4 Georgia,serif; }\n.ss-faq-source details { border-bottom:1px solid #d8d8cc; }\n\n</style>",
            "_css_classes": "ss-style-widget"
          },
