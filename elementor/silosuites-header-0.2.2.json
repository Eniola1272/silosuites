            "html": "<style>\n/* Scoped presentation helpers. Text, media, spacing, type and colour controls remain native. */\n:where(.ss-design) { --ss-ink:#181a16; --ss-olive:#7e8e76; --ss-cream:#f8f5eb; --ss-tan:#d6c3ae; color:var(--ss-ink); font-family:Arial,Helvetica,sans-serif; }\n:where(.ss-design) * { box-sizing:border-box; }\n:where(.ss-design) a { text-decoration:none; }\n:where(.ss-design) p:last-child { margin-bottom:0; }\n:where(.ss-design) .elementor-heading-title { text-transform:none; }\n:where(.ss-design) em { font-weight:400; }\n:where(.ss-design) :focus-visible { outline:2px solid currentColor; outline-offset:5px; }\n.ss-design.ss-wrap { max-width:min(1320px,calc(100% - 10vw)); margin-inline:auto; }\n.ss-design.ss-zero { min-height:0; height:0; overflow:visible; padding:0; margin:0; }\n.ss-design .ss-link .elementor-button { padding:10px 0; border-bottom:1px solid currentColor; }\n.ss-design .ss-button .elementor-button { min-height:50px; display:inline-flex; align-items:center; justify-content:space-between; gap:28px; }\n.ss-design .ss-has-arrow .elementor-button-content-wrapper { width:100%; }\n.ss-design .ss-has-arrow .elementor-button-text { display:flex; align-items:center; justify-content:space-between; gap:28px; text-align:left; }\n.ss-design .ss-has-arrow .elementor-button-text::after { content:'↗'; font-size:21px; line-height:1; }\n.ss-design .ss-card-image img { display:block; width:100%; height:330px; object-fit:cover; transition:transform .35s ease; }\n.ss-design .ss-card-image { overflow:hidden; }\n.ss-design .ss-card-image:hover img { transform:scale(1.025); }\n.ss-design .ss-hero { isolation:isolate; }\n.ss-design .ss-logo img { width:92px; height:80px; object-fit:contain; }\n.ss-design .ss-story-image img { width:100%; height:auto; aspect-ratio:1; object-fit:cover; border:8px solid #f8f5eb; }\n.ss-design .ss-soak-image img { width:100%; height:auto; aspect-ratio:1.93; object-fit:cover; }\n.ss-design .ss-soak-card { z-index:2; }\n.ss-design .ss-guide-image img { width:100%; height:auto; aspect-ratio:1.7; object-fit:cover; }\n.ss-design .ss-eyebrow .elementor-heading-title { line-height:1.7; }\n.ss-design .ss-style-widget { width:100%; margin:0; }\n.ss-search { display:grid; grid-template-columns:1fr 1fr .85fr 1.15fr; background:white; padding:20px; border:1px solid #e5e4da; box-shadow:0 12px 40px #0000000b; font-family:Arial,Helvetica,sans-serif; }\n.ss-search label { display:flex; flex-direction:column; justify-content:center; gap:8px; padding:3px 24px; border-right:1px solid #d8d8cc; min-width:0; }\n.ss-search label span { font-size:9px; font-weight:600; letter-spacing:.15em; text-transform:uppercase; }\n.ss-search input,.ss-search select { font:16px Arial,Helvetica,sans-serif; width:100%; color:#181a16; background:transparent; border:0; border-radius:0; padding:4px 0; min-height:32px; min-width:0; }\n.ss-search label:nth-child(3) { border:0; }\n.ss-search button { background:#7e8e76; color:#000; border:0; border-radius:0; font:12px Arial,Helvetica,sans-serif; min-height:62px; padding:15px 24px; display:flex; align-items:center; justify-content:space-between; gap:15px; cursor:pointer; }\n.ss-search button span { font-size:23px; }\n.ss-search button:hover { background:#9ba78f; }\n.ss-search-error { font:14px/1.6 Arial,Helvetica,sans-serif; color:#82382a; margin-top:12px; }\n.ss-search-note { font:11px/1.5 Arial,Helvetica,sans-serif; color:#595d54; margin:12px 0 0; }\n.ss-search-note a { text-decoration:underline; color:inherit; }\n.ss-mobile-menu { position:relative; font:13px Arial,Helvetica,sans-serif; }\n.ss-mobile-menu summary { min-height:44px; display:flex; align-items:center; cursor:pointer; list-style:none; }\n.ss-mobile-menu summary::-webkit-details-marker { display:none; }\n.ss-mobile-menu nav { position:absolute; right:0; top:52px; z-index:90; min-width:240px; padding:18px 24px; background:#f8f5eb; box-shadow:0 8px 25px #0002; }\n.ss-mobile-menu nav a { display:block; font:23px/1.3 Georgia,serif; color:#181a16; padding:14px 0; border-bottom:1px solid #d6c3ae; }\n@media(max-width:1024px) {\n  .ss-design.ss-wrap { max-width:calc(100% - 64px); }\n  .ss-design .ss-card-image img { height:270px; }\n  .ss-search label { padding-inline:16px; }\n}\n@media(max-width:767px) {\n  .ss-design.ss-wrap { max-width:calc(100% - 48px); }\n  .ss-design .ss-logo img { width:74px; height:68px; }\n  .ss-design .ss-card-image img { height:auto; aspect-ratio:1.16; }\n  .ss-design .ss-soak-image img { aspect-ratio:1.25; }\n  .ss-design .ss-story-image { max-width:390px; }\n  .ss-search { grid-template-columns:1fr 1fr; padding:10px; }\n  .ss-search label { padding:14px; min-height:80px; }\n  .ss-search label:nth-child(2) { border:0; }\n  .ss-search label:nth-child(3) { border-top:1px solid #d8d8cc; }\n  .ss-search button { margin:8px 0 0 8px; padding-inline:15px; }\n  .ss-search input,.ss-search select { font-size:16px; }\n}\n@media(prefers-reduced-motion:reduce) { .ss-design * { transition:none!important; animation:none!important; scroll-behavior:auto!important; } }\n\n</style>",
            "_css_classes": "ss-style-widget"
          },
