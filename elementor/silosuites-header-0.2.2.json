                    "html": "<details class=\"ss-mobile-menu\"><summary>Menu</summary><nav aria-label=\"Mobile navigation\"><a href=\"/our-silo-suites/\">Our suites ↗</a><a href=\"/#our-story\">Our story ↗</a><a href=\"/hot-springs/\">Stay & Soak ↗</a><a href=\"/local-guide/\">Local guide ↗</a></nav></details><script>(function(){function init(){document.querySelectorAll(\".ss-mobile-menu\").forEach(function(menu){if(menu.dataset.ssMenuBound)return;menu.dataset.ssMenuBound=\"yes\";menu.addEventListener(\"click\",function(e){if(e.target.closest(\"a\"))menu.open=false});document.addEventListener(\"keydown\",function(e){if(e.key===\"Escape\"&&menu.open){menu.open=false;menu.querySelector(\"summary\").focus()}});document.addEventListener(\"click\",function(e){if(menu.open&&!menu.contains(e.target))menu.open=false})})}if(document.readyState===\"loading\")document.addEventListener(\"DOMContentLoaded\",init);else init()})();</script>",
